# Disposable, isolated E2E environment. Copy to .env.e2e; never commit that file.
COMPOSE_PROJECT_NAME=warhammer-e2e
DEPOT_POSTGRES_DB=depot_e2e
DEPOT_POSTGRES_USER=depot_e2e
DEPOT_POSTGRES_PASSWORD=replace-with-a-disposable-password

# Reserved parent identity. This is deliberately distinct from Depot's default
# local user (...0001) and is inserted by the E2E bootstrap service.
WARHAMMER_E2E_PARENT_USER_ID=00000000-0000-0000-0000-000000000002

WARHAMMER_E2E_HOME_PORT=29105
DEPOT_E2E_PORT=29106
MUNDA_E2E_PORT=29107

# Required by the base Compose file; E2E replaces all public bindings with
# loopback-only ports.
DEPOT_TAILSCALE_IPV4_ADDR=127.0.0.1
DEPOT_TAILSCALE_ADDR=127.0.0.1
