# Public application ports.
WARHAMMER_HOME_PORT=19095
DEPOT_PORT=19096
MUNDA_PORT=19097

# Depot PostgreSQL is internal-only; use a strong value in .env.local.
DEPOT_POSTGRES_DB=depot
DEPOT_POSTGRES_USER=depot
DEPOT_POSTGRES_PASSWORD=replace-with-a-strong-local-password

# Tailscale IPv4 address for this host.
# Discover with: tailscale ip -4
DEPOT_TAILSCALE_IPV4_ADDR=

# Tailscale IPv6 address for this host, without brackets.
# Discover with: tailscale ip -6
DEPOT_TAILSCALE_ADDR=

# Munda Manager talks to a separately managed local Supabase CLI stack.
MUNDA_SUPABASE_URL=http://host.docker.internal:54321
MUNDA_SUPABASE_ANON_KEY=replace-with-local-supabase-anon-key
MUNDA_TURNSTILE_SITE_KEY=1x00000000000000000000AA
MUNDA_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
MUNDA_APP_URL=http://localhost:19097
