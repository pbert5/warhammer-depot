FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY vendor/mundamanager/package.json vendor/mundamanager/package-lock.json ./
RUN npm ci
COPY vendor/mundamanager/ ./
ARG MUNDA_BUILD_SUPABASE_URL=http://localhost:54321
ARG MUNDA_BUILD_SUPABASE_ANON_KEY=local-build-anon-key
ENV NEXT_PUBLIC_SUPABASE_URL=$MUNDA_BUILD_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$MUNDA_BUILD_SUPABASE_ANON_KEY
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ARG WARHAMMER_PARENT_REVISION=unknown
ARG MUNDA_SOURCE_REVISION=unknown
LABEL org.opencontainers.image.source.revision=$WARHAMMER_PARENT_REVISION \
      com.warhammer.munda.revision=$MUNDA_SOURCE_REVISION
COPY --from=build /app ./
EXPOSE 3000
CMD ["node", ".next/standalone/server.js"]
