FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY vendor/mundamanager/package.json vendor/mundamanager/package-lock.json ./
RUN npm ci
COPY vendor/mundamanager/ ./
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE 3000
CMD ["npm", "run", "start"]
